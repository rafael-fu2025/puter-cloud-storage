<?xml version="1.0" encoding="utf-8"?>
<!--
  What FileProvider is allowed to hand out to other apps.

  Narrow on purpose, and narrower than it used to be. Only one thing is ever
  shared: a file the user just downloaded, which lives in the app-specific
  external Downloads folder. Enumerating fewer roots means a mistake in the
  sharing path cannot reach the upload staging area, the SQLite index or the
  encrypted token store.

  The `cache-path` entry that used to be here is gone, because picked files are
  no longer staged in the cache — Android may empty that at any time, including
  while an upload is queued, which is why staging moved to `filesDir`. That
  location is deliberately *not* listed: the app never shares a staged upload,
  so it does not need to be reachable.
-->
<paths>
    <!-- Downloads, the only thing the app shares. Mirrors
         PlatformDeviceFiles.downloadDirectory(), which resolves to
         <external-files>/Downloads on Android. -->
    <external-files-path name="downloads" path="Downloads/" />
    <!-- The whole app-specific external root, so a download that landed at the
         top level — external storage unavailable at the time — is still
         openable. -->
    <external-files-path name="external_files" path="." />
</paths>
